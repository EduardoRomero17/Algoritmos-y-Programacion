// Realizar un algoritmo en pseudoco?digo para convertir grados Celsius a grados Kelvin y Fahrenheit.
Algoritmo ConversionGrados
	Definir celsius Como Real
	Escribir 'Ingresa los Grados Celsius'
	Leer celsius
	kelvin <- celsius+273.15
	fahrenheit <- (celsius*9/5)+32
	Escribir 'Grados Kelvin: ', kelvin
	Escribir 'Grados Fahrenheit: ', fahrenheit
FinAlgoritmo
